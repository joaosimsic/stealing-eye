#!/usr/bin/env bash
# Repo-local linker shim.
#
# Some nix dev shells inject a nix glibc rpath (via ~/.cargo/config.toml and
# CARGO_BUILD_RUSTFLAGS) and a nix ld-linux interpreter into every link, which
# makes plain `cargo build/run` produce binaries that abort at startup with
# "GLIBC_PRIVATE" / "libX.so not found". This wrapper drops those injected args
# and links with the system toolchain so `cargo run` works unmodified.
#
# If your environment is already clean, you can point .cargo/config.toml's
# linker back at "cc" and delete this script.
set -euo pipefail

args=()
for a in "$@"; do
  case "$a" in
    *-Wl,-rpath*|-fuse-ld=*) continue ;;
  esac
  args+=("$a")
done

exec /usr/bin/gcc "${args[@]}" -Wl,--dynamic-linker=/lib64/ld-linux-x86-64.so.2
